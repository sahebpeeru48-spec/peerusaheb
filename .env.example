# HealthAI Configuration
PORT=5000
NODE_ENV=development

# Optional AI LLM Keys (If empty, HealthAI automatically activates the comprehensive Clinical AI Reasoning Engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Database Keys (By default, HealthAI uses safe local persistent JSON storage in server/data/)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Secret for session signing
SESSION_SECRET=healthai-secure-secret-demo
